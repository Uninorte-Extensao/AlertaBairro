rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /alertas/{alertaId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uidUsuario == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.uidUsuario == request.auth.uid;
    }

    match /usuarios/{userId} {
      allow read, create, update: if request.auth != null
        && request.auth.uid == userId;
    }

    match /denuncias/{denunciaId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['alertaId', 'denuncianteUid', 'data'])
        && request.resource.data.keys().hasOnly(['alertaId', 'denuncianteUid', 'data'])
        && request.resource.data.alertaId is string
        && request.resource.data.denuncianteUid == request.auth.uid
        && denunciaId == request.resource.data.alertaId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/alertas/$(request.resource.data.alertaId))
        && get(/databases/$(database)/documents/alertas/$(request.resource.data.alertaId)).data.uidUsuario is string;
    }
  }
}
